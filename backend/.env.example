PORT=5000
CLIENT_ORIGIN=http://localhost:5500

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Seed admin (optional)
ADMIN_SEED_EMAIL=admin@seaforestuna.com
ADMIN_SEED_PASSWORD=Admin123!

# Gmail SMTP email receipts (optional)
# Use a Google App Password here, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-digit-google-app-password
SMTP_FROM=yourgmail@gmail.com
SMTP_FROM_NAME=SeaForestuna
SITE_TIMEZONE=Asia/Colombo
